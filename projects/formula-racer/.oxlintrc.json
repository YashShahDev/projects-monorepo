{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "curly": ["error", "all"],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": ["if", "function", "block-like"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      }
    ],
    "spacing/blank-line-before-nested-comment": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".cache/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    {
      "name": "spacing",
      "specifier": "./tools/oxlint/spacing-plugin.js"
    }
  ]
}
